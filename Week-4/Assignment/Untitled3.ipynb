    "%%writefile module3_function.py\n",
    "\n",
    "# Module 3 - Custom function\n",
    "\n",
    "def calculate_average(total_sales, total_transactions):\n",
    "\n",
    "    if total_transactions == 0:\n",
    "        return 0\n",
    "\n",
    "    average = total_sales / total_transactions\n",
    "\n",
    "    return average"
   ]
